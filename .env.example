# ==============================================================================
# WavFry Environment Variables Template
# Copy this file to .env and fill in your actual API keys.
# DO NOT commit .env to version control!
# ==============================================================================

# OpenRouter API Key (Used for Gemini TTS paralinguistic synthesis via OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Local LLM Gateway Key (Used for local model endpoint on 127.0.0.1:8045)
LOCAL_LLM_KEY=your_local_llm_key_here
